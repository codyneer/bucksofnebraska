NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=xxxxx
SHOPIFY_ADMIN_ACCESS_TOKEN=xxxxx
NEXT_PUBLIC_SITE_URL=https://bucksofnebraska.com
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=your-pixel-id
FB_CAPI_ACCESS_TOKEN=your-capi-access-token

# Facebook deer gallery (Community → Deer Gallery / homepage "From The Herd")
# FB_PAGE_ACCESS_TOKEN (required): Page token with pages_read_engagement
#   (use a System User token so it does not expire)
# FB_ALBUM_ID (optional): defaults to the deer album in code; set to override
FB_PAGE_ACCESS_TOKEN=your-page-access-token
# FB_ALBUM_ID=1160412546276308
